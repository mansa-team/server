# Docker build context ships the whole directory, so exclude everything the runtime image does not need.
# Rule: keep only what `COPY . .` + `python run.py` (config, main/, migrations, requirements) needs at runtime.
.git
.github
.gitignore
__pycache__
**/__pycache__/
*.pyc
**/*.pyc
*.pyo
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov
.vscode
.idea
*.egg-info
dist
build
tests
test
graft
*.md
LICENSE
Dockerfile
Dockerfile.forgevm
!Dockerfile.sandbox
docker-compose*.yml
.dockerignore
Makefile
*.db
*.sqlite
.agents
.opencode
.opencode.json
skills
node_modules
autoresearch-results.tsv
.autoresearch

cache/
frontend/
docs/
nginx/
.venv/
venv/
.env
*.env
coverage.xml