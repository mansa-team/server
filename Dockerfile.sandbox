FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    PIP_NO_CACHE_DIR=1

# install cpu-only: xgboost pulls nvidia-nccl (~300MB) — install then remove
RUN pip install --no-cache-dir \
    pandas numpy scipy \
    scikit-learn xgboost lightgbm statsmodels \
    plotly matplotlib seaborn \
    python-docx lxml xlsxwriter xlrd pymupdf holidays && \
    find /usr/local/lib/python3.13/site-packages/nvidia* -maxdepth 0 -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib -type d \( -name "tests" -o -name "test" -o -name "__pycache__" \) -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib -name "*.pyc" -delete 2>/dev/null; \
    find /usr/local/lib -name "*.pyi" -delete 2>/dev/null; \
    find /usr/local/lib -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null; \
    true

RUN useradd -m -u 1000 sandbox && \
    mkdir -p /workspace /tmp && \
    chown -R sandbox:sandbox /workspace

WORKDIR /workspace
USER sandbox